{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'PY=${PWD}/.venv/bin/python; [ -x \"$PY\" ] || PY=python3; \"$PY\" manage.py migrate --noinput && \"$PY\" manage.py seed_lms && \"$PY\" manage.py runserver 0.0.0.0:3000' --",
    "build": "sh -c 'PY=${PWD}/.venv/bin/python; [ -x \"$PY\" ] || PY=python3; \"$PY\" manage.py check'",
    "preview": "sh -c 'PY=${PWD}/.venv/bin/python; [ -x \"$PY\" ] || PY=python3; \"$PY\" manage.py runserver 0.0.0.0:3000'",
    "clean": "rm -rf db.sqlite3",
    "lint": "python3 -m compileall -q core lms_project manage.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
